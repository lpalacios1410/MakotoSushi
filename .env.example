# ── Entorno del sitio (copia este archivo a .env y complétalo) ─────────────
# .env es ignorado por git: nunca sube tokens al repositorio.

# Sanity CMS — proyecto donde el personal edita menú y sedes.
# Créalo gratis en https://www.sanity.io/manage
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Token de LECTURA: solo necesario si el dataset es privado.
# El build del sitio lo usa para traer el contenido publicado.
SANITY_API_READ_TOKEN=

# Token de ESCRITURA: SOLO para el script local "pnpm sembrar:sanity".
# NUNCA lo definas en el hosting (Cloudflare Pages).
SANITY_API_WRITE_TOKEN=

# ── Studio (sanity/.env) ───────────────────────────────────────────────────
# El Studio también lee su propio archivo sanity/.env:
#   SANITY_STUDIO_PROJECT_ID=<mismo project id>
#   SANITY_STUDIO_DATASET=production

# ── Build ──────────────────────────────────────────────────────────────────
# URL pública del sitio (por defecto https://makotosushi.com en astro.config.mjs).
# SITE_URL=https://makotosushi.com
