---
/**
 * Banner de promoción semanal (2x1 en delivery).
 */
import { MARCA, enlaceWhatsapp } from '../config';

const mensajePromo = `Hola ${MARCA.nombre}, quiero usar el código SUSHIFANS24 para el 2x1 en rolls.`;
---

<section id="promociones" class="relative">
  <div class="j-container j-section-tight">
    <div
      class="relative overflow-hidden rounded-[22px] border border-accent-line bg-card p-8 shadow-[var(--shadow-soft)] md:p-12"
    >
      <!-- Motivo de fondo: olas tenues -->
      <div class="j-pattern-shippo pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

      <div
        class="relative z-10 flex flex-col items-center justify-between gap-8 text-center lg:flex-row lg:text-left"
      >
        <div class="max-w-2xl">
          <div
            class="mb-4 inline-flex items-center gap-2 rounded-full bg-accent-soft px-3.5 py-1.5 font-label-sm text-label-sm font-bold tracking-widest text-accent-strong"
          >
            <span class="material-symbols-outlined text-sm" aria-hidden="true"
              >local_fire_department</span
            >
            Promoción Exclusiva Semanal
          </div>
          <h2
            class="font-headline-lg text-headline-lg-mobile leading-tight text-on-surface md:text-headline-lg"
          >
            ¡Martes &amp; Jueves de Rolls <span class="text-accent">2x1</span> en Delivery!
          </h2>
          <p class="mt-3 text-body-md text-ink-2">
            Aplica en todos nuestros rolls tradicionales y de autor al pedir por
            nuestro canal directo. Utiliza el código al confirmar tu orden.
          </p>
          <div
            class="mt-5 inline-flex items-center gap-3 rounded-[14px] border border-dashed border-accent-line bg-paper px-4 py-2.5"
          >
            <span class="text-body-sm text-ink-2">Código cupón:</span>
            <span class="font-mono text-label-md font-bold tracking-widest text-accent-strong"
              >SUSHIFANS24</span
            >
          </div>
        </div>

        <div class="flex shrink-0 flex-col gap-4 sm:flex-row">
          <a
            class="j-btn j-btn-accent"
            href={enlaceWhatsapp(mensajePromo)}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined" aria-hidden="true"
              >chat</span
            >
            Pedir por WhatsApp 2x1
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
