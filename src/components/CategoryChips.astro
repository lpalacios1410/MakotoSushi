---
/**
 * Chips de categoría: enlaces a cada página del menú.
 * Se generan desde la colección "menu" (orden por `orden`).
 */
import { getCollection } from 'astro:content';

const categorias = (await getCollection('menu')).sort((a, b) => a.data.orden - b.data.orden);
---

<div class="scrollbar-none mb-10 flex items-center gap-2 overflow-x-auto pb-4" aria-label="Categorías del menú">
  {
    categorias.map((cat) => (
      <a
        href={`/menu/${cat.id}/`}
        class="whitespace-nowrap rounded-full border border-outline-variant/30 bg-surface-container-high px-5 py-2.5 font-label-sm text-label-sm font-semibold text-on-surface/80 transition-all hover:bg-surface-container-highest hover:text-on-surface"
      >
        {cat.data.titulo}
      </a>
    ))
  }
</div>
