---
/**
 * Chips de categoría: enlaces a cada página del menú.
 * Se generan desde la colección "menu" (orden por `orden`).
 */
import { obtenerMenu } from '../lib/contenido';

const categorias = await obtenerMenu();
---

<div class="scrollbar-none mb-9 flex items-center gap-2 overflow-x-auto pb-4" aria-label="Categorías del menú">
  {
    categorias.map((cat) => (
      <a
        href={`/menu/${cat.id}/`}
        class="j-tag whitespace-nowrap px-4 py-2 text-label-sm font-semibold transition-colors duration-300 hover:border-accent-line hover:text-accent-strong"
      >
        {cat.data.titulo}
      </a>
    ))
  }
</div>
