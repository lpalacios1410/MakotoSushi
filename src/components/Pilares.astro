---
/**
 * Barra de propuesta de valor (4 pilares de la marca).
 */
const pilares = [
  {
    icono: 'set_meal',
    titulo: 'Calidad Premium',
    texto: 'Salmón fresco y cortes selectos seleccionados diariamente.',
  },
  {
    icono: 'local_shipping',
    titulo: 'Delivery Térmico',
    texto: 'Empaques especiales para preservar temperatura y crocancia.',
  },
  {
    icono: 'soup_kitchen',
    titulo: 'Cocina a la Vista',
    texto: 'Máxima higiene y pasión en barra abierta ante tus ojos.',
  },
  {
    icono: 'touch_app',
    titulo: 'Pide en 3 Clics',
    texto: 'Catálogo directo en la web o enlace rápido a WhatsApp.',
  },
];
---

<section class="j-band border-y border-hairline" aria-labelledby="titulo-pilares">
  <div class="j-container j-section-tight">
    <h2 id="titulo-pilares" class="sr-only">Por qué elegir Makoto Sushi</h2>
    <div class="grid grid-cols-1 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        pilares.map((pilar) => (
          <div class="flex items-start gap-4 px-0 sm:px-5 lg:px-6" data-reveal>
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-hairline bg-card text-accent-strong">
              <span class="material-symbols-outlined text-2xl" aria-hidden="true">
                {pilar.icono}
              </span>
            </div>
            <div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">{pilar.titulo}</h3>
              <p class="text-body-sm text-ink-2">{pilar.texto}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
