---
/**
 * Vista previa de las sedes en la landing (sustituye la sección
 * "Nuestro Local" del prototipo por el listado real del negocio).
 */
import { obtenerSedes } from '../lib/contenido';
import SedeCard from './SedeCard.astro';
import SectionEyebrow from './SectionEyebrow.astro';

const sedes = await obtenerSedes();
---

<section id="sedes" class="j-band relative border-y border-hairline">
  <div class="j-container j-section">
    <!-- Encabezado -->
    <div class="j-head">
      <SectionEyebrow numeral="02" etiqueta="Puntos de encuentro" />
      <h2 class="font-headline-lg text-headline-lg-mobile text-on-surface md:text-headline-lg">
        Vive la Experiencia en Barra o Pide a <span class="text-accent">Domicilio</span>
      </h2>
      <p class="lede max-w-xl">
        Cuatro sedes en Caracas combinan el dinamismo urbano de
        <strong class="font-semibold text-on-surface">Letsgo Sushi</strong> con la maestría de corte de
        <strong class="font-semibold text-on-surface">Makoto Sushi</strong>.
      </p>
      <a class="j-ink-link font-label-md text-label-md font-semibold" href="/sedes/">
        Conoce cada sede en detalle <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Grilla de sedes -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {sedes.map((sede) => <SedeCard sede={sede} />)}
    </div>
  </div>
</section>
