---
/**
 * Pie de página compartido.
 */
import { LOGO_URL, MARCA, REDES, enlaceWhatsapp } from '../config';

const enlaces = [
  { href: '/menu/', texto: 'Carta completa' },
  { href: '/sedes/', texto: 'Horarios de Atención' },
  { href: '/sedes/', texto: 'Zona de Cobertura' },
  { href: '/terminos/', texto: 'Términos y Condiciones' },
  { href: '/privacidad/', texto: 'Aviso de Privacidad' },
];
---

<footer class="relative mt-16 bg-paper-deep">
  <!-- Suelo con motivo de olas (seigaiha) -->
  <div class="j-pattern-edge" aria-hidden="true"></div>

  <div class="j-container flex w-full flex-col items-center justify-center gap-7 py-14 text-center">
    <!-- Logo e identidad -->
    <div class="flex flex-col items-center gap-4">
      <div class="relative">
        <div class="h-16 w-16 overflow-hidden rounded-full border border-hairline bg-card p-1">
          <img src={LOGO_URL} alt={`Logo oficial de ${MARCA.nombreCompleto}`} class="h-full w-full object-contain" width="64" height="64" loading="lazy" decoding="async" />
        </div>
        <!-- Sello decorativo (sin texto) -->
        <span
          class="absolute -right-2 -bottom-2 h-7 w-7 rotate-[-4deg] rounded-[18%] border-2 border-accent bg-accent-soft"
          aria-hidden="true"></span>
      </div>
      <span class="font-headline-md text-headline-md font-semibold tracking-wide text-on-surface">LETSGO SUSHI</span>
      <p class="max-w-md text-body-sm text-ink-2">
        Makoto Sushi Bar &amp; Delivery. Alta gastronomía japonesa y cocina urbana contemporánea.
      </p>
    </div>

    <!-- Redes sociales -->
    <div class="flex items-center gap-3">
      {
        REDES.map((red) => (
          <a
            class="flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-card text-ink-2 transition-all duration-300 hover:border-accent-line hover:text-accent-strong"
            href={red.href}
            aria-label={red.etiqueta}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined list-none text-xl" aria-hidden="true">{red.icono}</span>
          </a>
        ))
      }
    </div>

    <!-- Enlaces de interés -->
    <nav aria-label="Enlaces legales y de interés" class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 pt-1">
      {
        enlaces.map((enlace) => (
          <a class="j-ink-link font-label-sm text-label-sm" href={enlace.href}>
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <!-- Contacto directo -->
    <a
      class="j-btn j-btn-line j-btn-sm"
      href={enlaceWhatsapp()}
      rel="noopener noreferrer"
      target="_blank"
    >
      <span class="material-symbols-outlined text-base" aria-hidden="true">chat</span>
      Escríbenos por WhatsApp
    </a>

    <!-- Copyright -->
    <p class="w-full max-w-2xl border-t border-hairline pt-6 text-body-sm text-ink-3">
      © {new Date().getFullYear()} {MARCA.nombreCompleto}. Todos los derechos reservados.
    </p>
  </div>
</footer>
