---
/**
 * Pie de página compartido.
 */
import { LOGO_URL, MARCA, REDES, enlaceWhatsapp } from '../config';

const enlaces = [
  { href: '/menu/', texto: 'Carta completa' },
  { href: '/sedes/', texto: 'Horarios de Atención' },
  { href: '/sedes/', texto: 'Zona de Cobertura' },
  { href: '/terminos/', texto: 'Términos y Condiciones' },
  { href: '/privacidad/', texto: 'Aviso de Privacidad' },
];
---

<footer class="border-t border-outline-variant/20 bg-surface-container-lowest">
  <div class="mx-auto flex w-full max-w-7xl flex-col items-center justify-center gap-6 px-6 py-12 text-center">
    <!-- Logo e identidad -->
    <div class="flex flex-col items-center gap-3">
      <div class="h-16 w-16 overflow-hidden rounded-full border border-outline-variant/40 bg-surface p-1">
        <img src={LOGO_URL} alt={`Logo oficial de ${MARCA.nombreCompleto}`} class="h-full w-full object-contain" width="64" height="64" loading="lazy" decoding="async" />
      </div>
      <span class="font-headline-md text-headline-md font-extrabold text-on-surface">LETSGO SUSHI</span>
      <p class="max-w-md font-body-sm text-body-sm text-on-surface/70">
        Makoto Sushi Bar &amp; Delivery. Alta gastronomía japonesa y cocina urbana contemporánea.
      </p>
    </div>

    <!-- Redes sociales -->
    <div class="flex items-center gap-4">
      {
        REDES.map((red) => (
          <a
            class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container text-on-surface transition-all hover:bg-surface-container-high hover:text-primary"
            href={red.href}
            aria-label={red.etiqueta}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined list-none text-xl" aria-hidden="true">{red.icono}</span>
          </a>
        ))
      }
    </div>

    <!-- Enlaces de interés -->
    <nav aria-label="Enlaces legales y de interés" class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 pt-2">
      {
        enlaces.map((enlace) => (
          <a
            class="font-label-sm text-label-sm text-on-surface-variant transition-colors duration-150 hover:text-primary"
            href={enlace.href}
          >
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <!-- Contacto directo -->
    <a
      class="inline-flex items-center gap-2 rounded-lg border border-outline-variant/30 bg-surface-container px-4 py-2 font-label-sm text-label-sm font-semibold text-secondary transition-colors hover:border-secondary"
      href={enlaceWhatsapp()}
      rel="noopener noreferrer"
      target="_blank"
    >
      <span class="material-symbols-outlined text-base" aria-hidden="true">chat</span>
      Escríbenos por WhatsApp
    </a>

    <!-- Copyright -->
    <p class="w-full max-w-2xl border-t border-outline-variant/10 pt-6 font-body-sm text-body-sm text-on-surface/70">
      © {new Date().getFullYear()} {MARCA.nombreCompleto}. Todos los derechos reservados.
    </p>
  </div>
</footer>
