---
/**
 * Sección de reseñas de clientes (prueba social).
 */
import SectionEyebrow from './SectionEyebrow.astro';

const resenas = [
  {
    estrellas: 5,
    texto:
      '"El Makoto Avocado Roll es de otro planeta. La palta estaba mantecosa y el salmón fresquísimo. Llegó en menos de 30 minutos a mi departamento."',
    iniciales: 'CM',
    nombre: 'Camila Morales',
    detalle: 'Cliente frecuente delivery',
    clasesIniciales: 'text-accent-strong',
  },
  {
    estrellas: 5,
    texto:
      '"Ver la preparación en la barra en vivo te da una seguridad total. La atención de los chicos en Makoto Sushi es impecable y los rolls son gigantes."',
    iniciales: 'FR',
    nombre: 'Felipe Rivas',
    detalle: 'Visita en barra local',
    clasesIniciales: 'text-deep',
  },
  {
    estrellas: 5,
    texto:
      '"Aprovechamos el 2x1 de los martes y la calidad nunca baja. Los hot rolls llegan calientes y crocantes, no aceitosos. 10 de 10."',
    iniciales: 'VS',
    nombre: 'Valentina Silva',
    detalle: 'Pedido online',
    clasesIniciales: 'text-ink-2',
  },
];
---

<section id="opiniones" class="relative border-t border-hairline">
  <div class="j-container j-section">
    <!-- Encabezado -->
    <div class="j-head center">
      <SectionEyebrow numeral="04" etiqueta="Comunidad Letsgo" centro />
      <h2 class="font-headline-lg text-headline-lg-mobile text-on-surface md:text-headline-lg">
        Lo que Dicen <span class="text-accent">Nuestros Clientes</span>
      </h2>
      <p class="lede">
        La fidelidad de nuestros comensales es nuestra mejor carta de presentación.
      </p>
    </div>

    <!-- Grilla de reseñas -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        resenas.map((resena) => (
          <div class="j-card p-6" data-reveal>
            <div>
              <div class="mb-3 flex gap-1 text-accent-strong" role="img" aria-label={`Valoración: ${resena.estrellas} de 5 estrellas`}>
                {Array.from({ length: resena.estrellas }).map(() => (
                  <span class="material-symbols-outlined ms-fill text-sm" aria-hidden="true">
                    star
                  </span>
                ))}
              </div>
              <p class="text-body-md text-ink-2">{resena.texto}</p>
            </div>
            <div class="mt-5 flex items-center gap-3 border-t border-hairline pt-5">
              <div class={`flex h-10 w-10 items-center justify-center rounded-full bg-paper-deep font-bold ${resena.clasesIniciales}`}>
                {resena.iniciales}
              </div>
              <div>
                <p class="font-label-md text-label-md font-bold text-on-surface">{resena.nombre}</p>
                <p class="text-body-sm text-ink-3">{resena.detalle}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
