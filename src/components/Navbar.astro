---
/**
 * Barra de navegación superior (sticky, frosted glass).
 */
import { LOGO_URL, MARCA, enlaceWhatsapp } from '../config';

interface Props {
  /** Id de la sección activa para el subrayado del enlace */
  activo?: string;
}

const { activo } = Astro.props;

const enlaces = [
  { href: '/#inicio', id: 'inicio', texto: 'Inicio' },
  { href: '/menu/', id: 'catalogo', texto: 'Menú' },
  { href: '/#promociones', id: 'promociones', texto: 'Promociones' },
  { href: '/sedes/', id: 'sedes', texto: 'Sedes' },
  { href: '/#opiniones', id: 'opiniones', texto: 'Reseñas' },
];

/**
 * `aria-current` debe distinguir entre páginas (page) y secciones de la
 * página actual (true).
 */
function current(href: string, id: string): 'page' | 'true' | undefined {
  if (activo !== id) return undefined;
  return href.includes('#') ? 'true' : 'page';
}
---

<header class="sticky top-0 z-50 border-b border-hairline bg-[color-mix(in_srgb,var(--paper)_85%,transparent)] shadow-[0_10px_30px_-24px_rgb(var(--shadow-rgb)/0.5)] backdrop-blur-md">
  <div class="j-container flex w-full items-center justify-between py-4">
    <!-- Logo y nombre de la marca -->
    <a class="group flex items-center gap-3 transition-transform duration-150 active:scale-95" href="/#inicio">
      <div
        class="relative h-11 w-11 shrink-0 overflow-hidden rounded-full border border-hairline bg-card p-0.5 transition-colors group-hover:border-accent-line"
      >
        <img src={LOGO_URL} alt={`Logo de ${MARCA.nombreCompleto}`} class="h-full w-full object-contain" width="44" height="44" loading="eager" decoding="async" />
      </div>
      <div class="flex flex-col">
        <span class="font-headline-md text-headline-md font-semibold leading-tight tracking-wide text-on-surface">
          LETSGO SUSHI
        </span>
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-accent-strong">
          Makoto Sushi Bar
        </span>
      </div>
    </a>

    <!-- Navegación de escritorio -->
    <nav class="hidden items-center gap-2 md:flex" aria-label="Navegación principal">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            aria-current={current(enlace.href, enlace.id)}
            class:list={[
              'rounded-full px-3.5 py-1.5 font-label-md text-label-md transition-colors duration-300',
              activo === enlace.id
                ? 'bg-accent-soft font-bold text-accent-strong'
                : 'font-medium text-ink-2 hover:bg-tint hover:text-on-surface',
            ]}
          >
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <!-- Acciones a la derecha -->
    <div class="flex items-center gap-3">
      <!-- WhatsApp directo -->
      <a
        class="j-btn j-btn-line j-btn-sm hidden lg:inline-flex"
        href={enlaceWhatsapp()}
        rel="noopener noreferrer"
        target="_blank"
      >
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chat</span>
        <span>WhatsApp Delivery</span>
      </a>

      <!-- Carrito de pedidos (abre el drawer) -->
      <button
        class="relative rounded-full border border-hairline bg-card p-2.5 text-on-surface transition-colors duration-300 hover:bg-paper-deep active:scale-95"
        data-abrir-carrito
        aria-label="Ver carrito de pedidos"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">shopping_bag</span>
        <span
          data-cart-count
          class="absolute -top-1 -right-1 hidden h-5 w-5 items-center justify-center rounded-full border-2 border-card bg-accent-strong text-[10px] font-bold text-accent-ink"
          aria-hidden="true"
        >
          0
        </span>
      </button>

      <!-- CTA principal -->
      <a
        class="j-btn j-btn-accent j-btn-sm hidden sm:inline-flex"
        href="/menu/"
      >
        Pedir Ahora
      </a>

      <!-- Menú hamburguesa (móvil) -->
      <button
        id="menuBtn"
        class="rounded-full border border-hairline bg-card p-2.5 text-on-surface transition-colors duration-300 hover:bg-paper-deep active:scale-95 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menuMovil"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <!-- Menú móvil desplegable -->
  <nav id="menuMovil" class="hidden border-t border-hairline bg-surface md:hidden" aria-label="Navegación móvil">
    <div class="j-container flex flex-col gap-1 py-4">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            aria-current={current(enlace.href, enlace.id)}
            class:list={[
              'rounded-full px-3 py-2.5 font-label-md text-label-md transition-colors duration-300 hover:bg-tint',
              activo === enlace.id ? 'bg-accent-soft font-bold text-accent-strong' : 'text-ink-2',
            ]}
          >
            {enlace.texto}
          </a>
        ))
      }
      <a
        class="j-btn j-btn-accent mt-2 w-full"
        href="/menu/"
      >
        Pedir Ahora
      </a>
    </div>
  </nav>
</header>

<script>
  // Toggle del menú móvil
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('menuMovil');

  function cerrarMenuMovil() {
    if (!menu || !btn) return;
    menu.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Abrir menú');
  }

  btn?.addEventListener('click', () => {
    const abierto = !menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(abierto));
    btn.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });

  // Al pulsar un enlace del menú móvil, este se cierra
  menu?.querySelectorAll('a').forEach((enlace) => {
    enlace.addEventListener('click', cerrarMenuMovil);
  });

  // Escape cierra el menú móvil
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      cerrarMenuMovil();
      btn?.focus();
    }
  });
</script>
