---
/**
 * Card de plato para el catálogo.
 * Sin `imagen` renderiza un placeholder (la mayoría del menú real no tiene foto).
 * El botón "Añadir" dispara el carrito vía data-attributes (delegación en Carrito.astro).
 */
import type { Platillo } from '../lib/tipos';

interface Props {
  platillo: Platillo;
}

const { platillo } = Astro.props;

/** Estilos de badge según tipo (paleta del design system) */
const badgeEstilos = {
  oro: 'bg-gold-soft text-on-surface',
  fuego: 'bg-accent-soft text-accent-strong',
  picante: 'bg-error-container text-on-error-container',
  fresco: 'bg-leaf-soft text-on-surface',
  neutro: 'border border-hairline bg-paper-deep text-ink-2',
  flameado: 'bg-gold-soft text-on-surface',
} satisfies Record<string, string>;

const claseBadge = platillo.badge ? badgeEstilos[platillo.badge.tipo] : '';
const precio = '$' + platillo.precio.toLocaleString('es-VE');
---

<article class="j-card group overflow-hidden" data-reveal>
  <div class="relative h-44 overflow-hidden bg-paper-deep">
    {
      platillo.imagen ? (
        <img
          src={platillo.imagen}
          alt={`${platillo.nombre} — Makoto Sushi`}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          width="400"
          height="176"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-paper-deep to-paper text-ink-3">
          <span class="material-symbols-outlined text-5xl" aria-hidden="true">
            set_meal
          </span>
        </div>
      )
    }
    {
      platillo.badge && (
        <div class={`absolute top-3 right-3 rounded-full px-3 py-1 font-label-sm text-label-sm font-bold tracking-widest uppercase ${claseBadge}`}>
          {platillo.badge.texto}
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <h3 class="font-headline-sm text-headline-sm text-on-surface">{platillo.nombre}</h3>
      <p class="mt-1 line-clamp-3 text-body-sm text-ink-2">{platillo.descripcion}</p>
    </div>

    <div class="mt-4 flex items-center justify-between border-t border-hairline pt-5">
      <span class="j-price">
        <span class="sr-only">Precio:</span>
        {precio}
      </span>
      <button
        type="button"
        class="j-btn j-btn-line j-btn-sm"
        data-add-to-cart={platillo.id}
        data-nombre={platillo.nombre}
        data-precio={platillo.precio}
        aria-label={`Añadir ${platillo.nombre} al carrito`}
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">add</span>
        Añadir
      </button>
    </div>
  </div>
</article>
