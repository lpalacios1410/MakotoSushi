---
/**
 * Sección de catálogo con platos destacados.
 * Los chips filtran por categoría y enlazan con la carta completa.
 */
import { z } from 'astro/zod';
import CategoryChips from './CategoryChips.astro';
import DishCard from './DishCard.astro';
import SectionEyebrow from './SectionEyebrow.astro';
import destacados from '../data/destacados.json';
import { TIPOS_BADGE } from '../lib/tipos';

/** El JSON de destacados se valida en build: si alguien edita el archivo mal, falla el build. */
const schemaDestacados = z.array(
  z.object({
    id: z.string(),
    nombre: z.string(),
    descripcion: z.string(),
    precio: z.number().nonnegative(),
    badge: z.object({ texto: z.string(), tipo: z.enum(TIPOS_BADGE) }).optional(),
    imagen: z.url().optional(),
  }),
);

const platillos = schemaDestacados.parse(destacados);
---

<section id="catalogo" class="relative">
  <div class="j-container j-section">
    <!-- Encabezado de la sección -->
    <div class="j-head">
      <SectionEyebrow numeral="01" etiqueta="Carta gastronómica" />
      <h2 class="font-headline-lg text-headline-lg-mobile text-on-surface md:text-headline-lg">
        Nuestro <span class="text-accent">Catálogo</span> Exclusivo
      </h2>
      <p class="lede max-w-xl">
        Preparaciones minuciosas elaboradas con arroz sazonado a punto, palta Hass seleccionada y toppings que desafían lo
        convencional.
      </p>
      <a class="j-ink-link font-label-md text-label-md font-semibold" href="/menu/">
        Ver el menú completo <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Chips de categoría -->
    <CategoryChips />

    <!-- Grilla de platos -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {platillos.map((platillo) => <DishCard platillo={platillo} />)}
    </div>
  </div>
</section>
