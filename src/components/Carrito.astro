---
/**
 * Carrito de pedidos → WhatsApp.
 * Drawer lateral en desktop / bottom-sheet en móvil (ver DESIGN.md).
 * Todo corre en el navegador del cliente: estado en localStorage, sin backend.
 *
 * Accesibilidad: el drawer es un diálogo modal (`role="dialog"` + `aria-modal`),
 * se abre con foco gestionado, atrapa el tabulador, se cierra con Escape
 * y queda fuera del orden de tabulación mientras está cerrado (`inert`).
 */
import { getCollection } from 'astro:content';

const sedes = (await getCollection('sedes')).sort((a, b) => a.data.orden - b.data.orden);
---

<!-- Overlay de fondo -->
<div id="carrito-overlay" class="pointer-events-none fixed inset-0 z-[60] bg-black/60 opacity-0 backdrop-blur-sm transition-opacity duration-300" aria-hidden="true"></div>

<!-- Drawer del carrito -->
<aside id="carrito-drawer" class="cerrado fixed inset-x-0 bottom-0 z-[70] flex max-h-[88dvh] flex-col rounded-t-2xl border-t border-outline-variant/40 bg-surface-container-low shadow-2xl md:inset-y-0 md:left-auto md:right-0 md:w-[26rem] md:max-h-none md:rounded-none md:border-t-0 md:border-l" role="dialog" aria-modal="true" aria-label="Carrito de pedidos" inert aria-hidden="true">
  <!-- Encabezado -->
  <header class="flex items-center justify-between border-b border-outline-variant/30 bg-surface-container px-5 py-4">
    <div class="flex items-center gap-2.5">
      <span class="material-symbols-outlined text-primary" aria-hidden="true">shopping_bag</span>
      <h2 class="font-headline-sm text-headline-sm text-on-surface">Tu Pedido</h2>
    </div>
    <button id="btn-cerrar-carrito" class="rounded-lg border border-outline-variant/30 bg-surface-container p-1.5 text-on-surface/70 transition-colors hover:bg-surface-container-high hover:text-on-surface" aria-label="Cerrar carrito">
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
  </header>

  <!-- ══ Vista 1: ítems del carrito ══ -->
  <div id="vista-items" class="flex min-h-0 flex-1 flex-col">
    <!-- Estado vacío -->
    <div id="estado-vacio" class="hidden flex-col items-center gap-3 px-6 py-12 text-center">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-surface-container text-on-surface/70">
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">ramen_dining</span>
      </div>
      <p class="font-headline-sm text-headline-sm text-on-surface">Tu carrito está vacío</p>
      <p class="font-body-sm text-body-sm text-on-surface/70">Explora el menú y añade tus platos favoritos.</p>
      <a class="mt-2 inline-flex items-center gap-2 rounded-lg bg-primary-container px-5 py-2.5 font-label-md text-label-md font-bold text-on-primary-container transition-all hover:opacity-90 active:scale-95" href="/menu/" data-cerrar-carrito>
        <span class="material-symbols-outlined text-base" aria-hidden="true">restaurant_menu</span>
        Explorar Menú
      </a>
    </div>

    <!-- Lista de ítems -->
    <ul id="lista-items" class="scrollbar-none flex-1 divide-y divide-outline-variant/20 overflow-y-auto px-5"></ul>

    <!-- Pie: totales y CTA -->
    <div id="pie-items" class="border-t border-outline-variant/30 bg-surface-container px-5 py-4">
      <div class="mb-1 flex items-center justify-between">
        <span class="font-label-md text-label-sm uppercase tracking-wider text-on-surface/70">Total (sin IVA ni 10%)</span>
        <span id="valor-subtotal" class="font-headline-md text-headline-md font-extrabold text-on-surface">$0</span>
      </div>
      <button id="btn-vaciar" class="mb-3 font-body-sm text-body-sm text-on-surface/70 transition-colors hover:text-error" type="button">Vaciar carrito</button>
      <button id="btn-finalizar" class="glow-primary flex w-full items-center justify-center gap-2 rounded-lg bg-primary-container px-5 py-3.5 font-label-md text-label-md font-bold tracking-wider text-on-primary-container transition-all hover:opacity-90 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40 disabled:active:scale-100" type="button" disabled>
        <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
        Finalizar Pedido
      </button>
    </div>
  </div>

  <!-- ══ Vista 2: datos del pedido ══ -->
  <form id="form-pedido" class="scrollbar-none hidden min-h-0 flex-1 flex-col overflow-y-auto px-5 py-5" novalidate>
    <button id="btn-volver" class="mb-4 inline-flex w-fit items-center gap-1.5 font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70 transition-colors hover:text-primary" type="button">
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
      Volver al carrito
    </button>

    <!-- Modalidad -->
    <fieldset class="mb-4">
      <legend class="mb-2 font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70">Modalidad</legend>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-modalidad="delivery" aria-pressed="true" class="boton-modalidad flex items-center justify-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container px-3 py-2.5 font-label-sm text-label-sm font-bold text-on-surface/80 transition-all">
          <span class="material-symbols-outlined text-base" aria-hidden="true">moped</span>
          Delivery
        </button>
        <button type="button" data-modalidad="pickup" aria-pressed="false" class="boton-modalidad flex items-center justify-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container px-3 py-2.5 font-label-sm text-label-sm font-bold text-on-surface/80 transition-all">
          <span class="material-symbols-outlined text-base" aria-hidden="true">takeout_dining</span>
          Pick Up
        </button>
      </div>
    </fieldset>

    <!-- Sede -->
    <div class="mb-4">
      <label class="mb-2 block font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70" for="campo-sede">Sede</label>
      <select id="campo-sede" name="sede" required aria-describedby="ayuda-sede" class="w-full rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 font-body-md text-body-md text-on-surface outline-none focus:border-primary-container">
        {
          sedes.map((sede) => (
            <option
              value={sede.id}
              data-nombre={sede.data.nombre}
              data-modalidades={sede.data.modalidades.join(',')}
              data-whatsapp={sede.data.whatsapp ?? ''}
            >
              {sede.data.nombre} — {sede.data.ciudad}
            </option>
          ))
        }
      </select>
      <p id="ayuda-sede" class="mt-1.5 font-body-sm text-body-sm text-on-surface/70">La sede elegida recibe tu pedido por WhatsApp.</p>
    </div>

    <!-- Dirección (solo delivery) -->
    <div id="bloque-direccion" class="mb-4">
      <label class="mb-2 block font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70" for="campo-direccion">Dirección de entrega</label>
      <input id="campo-direccion" name="direccion" type="text" required autocomplete="street-address" placeholder="Av. / Edificio / Apto." class="w-full rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-on-surface/60 outline-none focus:border-primary-container" />
      <label class="mb-2 mt-3 block font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70" for="campo-referencia">Referencia (opcional)</label>
      <input id="campo-referencia" name="referencia" type="text" placeholder="Portón negro, junto a la panadería..." class="w-full rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-on-surface/60 outline-none focus:border-primary-container" />
    </div>

    <!-- Método de pago -->
    <fieldset class="mb-4">
      <legend class="mb-2 font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70">Método de pago</legend>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-pago="usd" aria-pressed="true" class="boton-pago flex items-center justify-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container px-3 py-2.5 font-label-sm text-label-sm font-bold text-on-surface/80 transition-all">
          Efectivo ($)
        </button>
        <button type="button" data-pago="bs" aria-pressed="false" class="boton-pago flex items-center justify-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container px-3 py-2.5 font-label-sm text-label-sm font-bold text-on-surface/80 transition-all">
          Efectivo (Bs)
        </button>
      </div>
      <p class="mt-2 font-body-sm text-body-sm text-on-surface/70">El pago se realiza al recibir el pedido.</p>
    </fieldset>

    <!-- Datos personales -->
    <div class="mb-4 flex flex-col gap-3">
      <div>
        <label class="mb-2 block font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70" for="campo-nombre">Nombre y apellido</label>
        <input id="campo-nombre" name="nombre" type="text" required autocomplete="name" placeholder="María Pérez" class="w-full rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-on-surface/60 outline-none focus:border-primary-container" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="mb-2 block font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70" for="campo-telefono">Teléfono</label>
          <input id="campo-telefono" name="telefono" type="tel" required autocomplete="tel" inputmode="tel" placeholder="0414-1234567" class="w-full rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-on-surface/60 outline-none focus:border-primary-container" />
        </div>
        <div>
          <label class="mb-2 block font-label-sm text-label-sm uppercase tracking-wider text-on-surface/70" for="campo-cedula">Cédula</label>
          <input id="campo-cedula" name="cedula" type="text" required autocomplete="off" placeholder="V-19.876.543" class="w-full rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-on-surface/60 outline-none focus:border-primary-container" />
        </div>
      </div>
    </div>

    <!-- Resumen + envío -->
    <div class="mt-auto">
      <div class="mb-3 flex items-center justify-between rounded-xl border border-outline-variant/30 bg-surface-container px-4 py-3">
        <span class="font-label-md text-label-sm uppercase tracking-wider text-on-surface/70">Total a pagar</span>
        <span id="valor-total-form" class="font-headline-md text-headline-md font-extrabold text-on-surface">$0</span>
      </div>

      <!-- Error (p. ej. sede sin WhatsApp configurado) -->
      <div id="error-pedido" role="alert" class="mb-3 hidden items-start gap-2 rounded-xl border border-error-container/60 bg-error-container/20 px-4 py-3 text-on-surface">
        <span class="material-symbols-outlined text-lg text-error" aria-hidden="true">warning</span>
        <p id="error-pedido-texto" class="font-body-sm text-body-sm"></p>
      </div>

      <button id="btn-enviar" type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-secondary px-5 py-4 font-label-md text-label-md font-bold tracking-wider text-on-secondary shadow-lg transition-all hover:opacity-90 active:scale-95">
        <span class="material-symbols-outlined" aria-hidden="true">chat</span>
        Enviar Pedido por WhatsApp
      </button>
      <p class="mt-3 text-center font-body-sm text-body-sm text-on-surface/70">Los precios no incluyen IVA ni el 10% de servicio.</p>
    </div>
  </form>
</aside>

<!-- Toast de confirmación -->
<div id="toast-carrito" role="status" aria-live="polite" aria-atomic="true" class="pointer-events-none fixed bottom-6 right-6 z-[80] translate-y-4 opacity-0 transition-all duration-300 max-md:inset-x-4 max-md:bottom-4">
  <div class="flex items-center gap-3 rounded-xl border border-primary-container bg-surface-container-high px-5 py-3.5 text-on-surface shadow-2xl">
    <span class="material-symbols-outlined ms-fill text-xl text-primary" aria-hidden="true">check_circle</span>
    <div>
      <p id="toast-titulo" class="font-label-md text-label-md font-bold text-on-surface">Producto añadido</p>
      <p class="font-body-sm text-body-sm text-on-surface/70">Revisa tu carrito para proceder</p>
    </div>
  </div>
</div>

<style>
  /* Animación de apertura/cierre: bottom-sheet en móvil, panel lateral en desktop */
  #carrito-drawer {
    transition: transform 300ms ease;
  }
  #carrito-drawer.cerrado {
    transform: translateY(100%);
  }
  @media (min-width: 768px) {
    #carrito-drawer.cerrado {
      transform: translateX(100%);
    }
  }
</style>

<script>
  import {
    agregarProducto,
    cambiarCantidad,
    formatearPrecio,
    obtenerCarrito,
    quitarProducto,
    totalItems,
    totalPrecio,
    vaciarCarrito,
  } from '../scripts/carrito';

  /* ── Referencias del DOM ─────────────────────────────────── */
  const overlay = document.getElementById('carrito-overlay');
  const drawer = document.getElementById('carrito-drawer');
  const listaItems = document.getElementById('lista-items');
  const estadoVacio = document.getElementById('estado-vacio');
  const valorSubtotal = document.getElementById('valor-subtotal');
  const btnFinalizar = document.getElementById('btn-finalizar') as HTMLButtonElement;
  const btnVaciar = document.getElementById('btn-vaciar');
  const vistaItems = document.getElementById('vista-items');
  const formPedido = document.getElementById('form-pedido') as HTMLFormElement;
  const btnVolver = document.getElementById('btn-volver');
  const campoSede = document.getElementById('campo-sede') as HTMLSelectElement;
  const bloqueDireccion = document.getElementById('bloque-direccion');
  const campoDireccion = document.getElementById('campo-direccion') as HTMLInputElement;
  const valorTotalForm = document.getElementById('valor-total-form');
  const errorPedido = document.getElementById('error-pedido');
  const errorTexto = document.getElementById('error-pedido-texto');
  const toast = document.getElementById('toast-carrito');
  const toastTitulo = document.getElementById('toast-titulo');

  /* ── Estado del checkout ─────────────────────────────────── */
  let modalidad: 'delivery' | 'pickup' = 'delivery';
  let pago: 'usd' | 'bs' = 'usd';
  /** Elemento que tenía el foco al abrir el drawer (para devolvérselo al cerrar). */
  let ultimoFoco: HTMLElement | null = null;

  const SELECCIONABLES =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  /** Elementos focalizables visibles dentro del drawer. */
  function obtenerFocales(contenedor: HTMLElement): HTMLElement[] {
    return Array.from(contenedor.querySelectorAll<HTMLElement>(SELECCIONABLES)).filter(
      (el) => el.offsetWidth > 0 || el.offsetHeight > 0 || el === document.activeElement,
    );
  }

  /* ── Utilidades ──────────────────────────────────────────── */
  function escapar(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    // `innerHTML` no escapa las comillas, necesarias para atributos (aria-label).
    return div.innerHTML.replace(/"/g, '&quot;');
  }

  function mostrarError(mensaje: string) {
    if (errorPedido && errorTexto) {
      errorTexto.textContent = mensaje;
      errorPedido.classList.remove('hidden');
      errorPedido.classList.add('flex');
    }
  }

  function ocultarError() {
    errorPedido?.classList.add('hidden');
    errorPedido?.classList.remove('flex');
  }

  let temporizadorToast: ReturnType<typeof setTimeout> | undefined;
  function mostrarToast(titulo: string) {
    if (!toast || !toastTitulo) return;
    toastTitulo.textContent = titulo;
    toast.classList.remove('translate-y-4', 'opacity-0');
    clearTimeout(temporizadorToast);
    temporizadorToast = setTimeout(() => toast.classList.add('translate-y-4', 'opacity-0'), 2500);
  }

  /* ── Apertura / cierre del drawer ────────────────────────── */
  function bloquearScroll(activo: boolean) {
    // En desktop el drawer es un panel lateral: la página de fondo sigue siendo navegable.
    const esHojaInferior = !window.matchMedia('(min-width: 768px)').matches;
    document.body.style.overflow = activo && esHojaInferior ? 'hidden' : '';
  }

  /**
   * Mientras el drawer está abierto, el resto de la página se marca como
   * `inert` para que el teclado y los lectores de pantalla solo recorran
   * el contenido del diálogo (comportamiento modal).
   */
  function aislarFondo(aislado: boolean) {
    const fondo = [document.querySelector('header'), document.querySelector('main'), document.querySelector('footer')];
    for (const elemento of fondo) {
      if (!elemento) continue;
      if (aislado) elemento.setAttribute('inert', '');
      else elemento.removeAttribute('inert');
    }
  }

  function abrirCarrito() {
    if (!drawer) return;
    ultimoFoco = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    drawer.classList.remove('cerrado');
    drawer.removeAttribute('inert');
    drawer.removeAttribute('aria-hidden');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    renderizar();
    bloquearScroll(true);
    aislarFondo(true);
    // El foco entra al diálogo para que el teclado no quede detrás del overlay.
    requestAnimationFrame(() => {
      const [primerFoco] = obtenerFocales(drawer);
      (primerFoco ?? drawer).focus();
    });
  }

  function cerrarCarrito() {
    drawer?.classList.add('cerrado');
    drawer?.setAttribute('inert', '');
    drawer?.setAttribute('aria-hidden', 'true');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    bloquearScroll(false);
    aislarFondo(false);
    ultimoFoco?.focus();
    ultimoFoco = null;
  }

  document.querySelectorAll('[data-abrir-carrito]').forEach((btn) => btn.addEventListener('click', abrirCarrito));
  document.getElementById('btn-cerrar-carrito')?.addEventListener('click', cerrarCarrito);
  overlay?.addEventListener('click', cerrarCarrito);
  // Enlaces internos marcados con data-cerrar-carrito (p. ej. "Explorar Menú")
  document.querySelectorAll('[data-cerrar-carrito]').forEach((el) => el.addEventListener('click', cerrarCarrito));

  /* ── Teclado: Escape cierra y Tab queda atrapado en el diálogo ── */
  document.addEventListener('keydown', (e) => {
    if (!drawer || drawer.hasAttribute('inert')) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      cerrarCarrito();
      return;
    }

    if (e.key !== 'Tab') return;

    const focales = obtenerFocales(drawer);
    if (focales.length === 0) return;

    const primero = focales[0];
    const ultimo = focales[focales.length - 1];

    if (e.shiftKey && document.activeElement === primero) {
      e.preventDefault();
      ultimo.focus();
    } else if (!e.shiftKey && document.activeElement === ultimo) {
      e.preventDefault();
      primero.focus();
    }
  });

  /* ── Render del carrito ──────────────────────────────────── */
  function renderizar() {
    const items = obtenerCarrito();
    const hayItems = items.length > 0;

    // Estado vacío vs lista
    estadoVacio?.classList.toggle('hidden', hayItems);
    estadoVacio?.classList.toggle('flex', !hayItems);
    if (listaItems) listaItems.innerHTML = items.map(plantillaItem).join('');

    // Totales
    if (valorSubtotal) valorSubtotal.textContent = formatearPrecio(totalPrecio());
    if (valorTotalForm) valorTotalForm.textContent = formatearPrecio(totalPrecio());
    if (btnFinalizar) btnFinalizar.disabled = !hayItems;

    // Badge del navbar + nombre accesible del botón
    const n = totalItems();
    document.querySelectorAll('[data-cart-count]').forEach((badge) => {
      badge.textContent = String(n);
      badge.classList.toggle('hidden', n === 0);
    });
    document.querySelectorAll('[data-abrir-carrito]').forEach((btn) => {
      btn.setAttribute(
        'aria-label',
        n === 0 ? 'Ver carrito de pedidos, vacío' : `Ver carrito de pedidos, ${n} ${n === 1 ? 'artículo' : 'artículos'}`,
      );
    });
  }

  function plantillaItem(item: { id: string; nombre: string; precio: number; cantidad: number }): string {
    return `
      <li class="flex items-center gap-3 py-4">
        <div class="min-w-0 flex-1">
          <p class="truncate font-label-md text-label-md font-bold text-on-surface">${escapar(item.nombre)}</p>
          <p class="font-body-sm text-body-sm text-on-surface/70">${formatearPrecio(item.precio)} c/u</p>
        </div>
        <div class="flex items-center gap-1 rounded-lg border border-outline-variant/30 bg-surface-container">
          <button type="button" data-restar="${escapar(item.id)}" class="px-2 py-1.5 text-on-surface/80 hover:text-primary" aria-label="Quitar uno de ${escapar(item.nombre)}">
            <span class="material-symbols-outlined text-base" aria-hidden="true">remove</span>
          </button>
          <span class="min-w-6 text-center font-label-md text-label-md font-bold text-on-surface">${item.cantidad}</span>
          <button type="button" data-sumar="${escapar(item.id)}" class="px-2 py-1.5 text-on-surface/80 hover:text-primary" aria-label="Agregar uno de ${escapar(item.nombre)}">
            <span class="material-symbols-outlined text-base" aria-hidden="true">add</span>
          </button>
        </div>
        <div class="flex w-16 flex-col items-end">
          <span class="font-label-md text-label-md font-bold text-on-surface">${formatearPrecio(item.precio * item.cantidad)}</span>
          <button type="button" data-quitar="${escapar(item.id)}" class="mt-1 text-on-surface/60 transition-colors hover:text-error" aria-label="Eliminar ${escapar(item.nombre)} del carrito">
            <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
          </button>
        </div>
      </li>`;
  }

  // Delegación: steppers y eliminar dentro de la lista
  listaItems?.addEventListener('click', (e) => {
    const objetivo = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-restar],button[data-sumar],button[data-quitar]');
    if (!objetivo) return;
    const id = objetivo.dataset.restar ?? objetivo.dataset.sumar ?? objetivo.dataset.quitar;
    if (!id) return;
    if (objetivo.dataset.quitar !== undefined) quitarProducto(id);
    else cambiarCantidad(id, objetivo.dataset.sumar !== undefined ? 1 : -1);
  });

  // Delegación global: botones "Añadir" de las cards del menú
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-add-to-cart]');
    if (!btn) return;
    const id = btn.dataset.addToCart;
    const nombre = btn.dataset.nombre;
    const precio = Number(btn.dataset.precio);
    if (!id || !nombre || Number.isNaN(precio)) return;
    agregarProducto(id, nombre, precio);
    mostrarToast(`${nombre} añadido`);
  });

  btnVaciar?.addEventListener('click', () => vaciarCarrito());
  window.addEventListener('carrito:cambio', renderizar);

  /* ── Navegación entre vistas ─────────────────────────────── */
  btnFinalizar?.addEventListener('click', () => {
    vistaItems?.classList.add('hidden');
    formPedido?.classList.remove('hidden');
    formPedido?.classList.add('flex');
    ocultarError();
    renderizar();
    campoSede?.focus();
  });

  btnVolver?.addEventListener('click', () => {
    formPedido?.classList.add('hidden');
    formPedido?.classList.remove('flex');
    vistaItems?.classList.remove('hidden');
    ocultarError();
    btnFinalizar?.focus();
  });

  /* ── Toggles de modalidad y pago ─────────────────────────── */
  function claseActiva(activo: boolean): string {
    return activo
      ? 'border-primary-container bg-primary-container/15 text-primary glow-primary'
      : 'border-outline-variant/40 bg-surface-container text-on-surface/80';
  }

  function pintarToggles() {
    document.querySelectorAll<HTMLButtonElement>('.boton-modalidad').forEach((btn) => {
      const activo = btn.dataset.modalidad === modalidad;
      btn.setAttribute('aria-pressed', String(activo));
      btn.className = `boton-modalidad flex items-center justify-center gap-2 rounded-lg border px-3 py-2.5 font-label-sm text-label-sm font-bold transition-all ${claseActiva(activo)}`;
    });
    document.querySelectorAll<HTMLButtonElement>('.boton-pago').forEach((btn) => {
      const activo = btn.dataset.pago === pago;
      btn.setAttribute('aria-pressed', String(activo));
      btn.className = `boton-pago flex items-center justify-center gap-2 rounded-lg border px-3 py-2.5 font-label-sm text-label-sm font-bold transition-all ${claseActiva(activo)}`;
    });
  }

  document.querySelectorAll('.boton-modalidad').forEach((btn) => {
    btn.addEventListener('click', () => {
      modalidad = (btn as HTMLButtonElement).dataset.modalidad as 'delivery' | 'pickup';
      // Dirección solo obligatoria en delivery
      campoDireccion.required = modalidad === 'delivery';
      bloqueDireccion?.classList.toggle('hidden', modalidad !== 'delivery');
      filtrarSedes();
      pintarToggles();
    });
  });

  document.querySelectorAll('.boton-pago').forEach((btn) => {
    btn.addEventListener('click', () => {
      pago = (btn as HTMLButtonElement).dataset.pago as 'usd' | 'bs';
      pintarToggles();
    });
  });

  /** Filtra las sedes del select según la modalidad elegida */
  function filtrarSedes() {
    if (!campoSede) return;
    let primeraValida: HTMLOptionElement | null = null;
    for (const opcion of Array.from(campoSede.options)) {
      const valida = (opcion.dataset.modalidades ?? '').split(',').includes(modalidad);
      opcion.hidden = !valida;
      opcion.disabled = !valida;
      if (valida && !primeraValida) primeraValida = opcion;
    }
    const seleccionada = campoSede.selectedOptions[0];
    if (!seleccionada || seleccionada.hidden) {
      campoSede.value = primeraValida?.value ?? '';
    }
  }

  /* ── Envío del pedido → WhatsApp ─────────────────────────── */
  formPedido?.addEventListener('submit', (e) => {
    e.preventDefault();
    ocultarError();

    const items = obtenerCarrito();
    if (items.length === 0) {
      mostrarError('Tu carrito está vacío. Añade platos antes de enviar el pedido.');
      return;
    }

    // Validación nativa de los campos required
    if (!formPedido.reportValidity()) return;

    const datos = new FormData(formPedido);
    const sedeOpcion = campoSede.selectedOptions[0];

    if (!sedeOpcion || !sedeOpcion.value) {
      mostrarError(
        modalidad === 'delivery'
          ? 'No hay sedes con delivery disponible en este momento. Prueba con la modalidad Pick Up.'
          : 'No hay sedes con pick-up disponible en este momento.',
      );
      return;
    }

    const whatsapp = sedeOpcion.dataset.whatsapp;

    if (!whatsapp) {
      mostrarError(
        `La sede ${sedeOpcion.dataset.nombre ?? 'elegida'} aún no tiene número de WhatsApp configurado. ` +
          'Agrégalo en src/content/sedes/ para habilitar el envío.',
      );
      return;
    }

    // Armado del mensaje con el formato acordado
    const lineas: string[] = [
      '🥢 *NUEVO PEDIDO — Makoto Sushi*',
      '',
      '*Pedido:*',
      ...items.map((i) => `• ${i.cantidad}x ${i.nombre} — ${formatearPrecio(i.precio * i.cantidad)}`),
      `*Total: ${formatearPrecio(totalPrecio())}*`,
      '',
      `*Modalidad:* ${modalidad === 'delivery' ? 'Delivery' : 'Pick-up'}`,
      `*Sede:* ${sedeOpcion.dataset.nombre}`,
      `*Pago:* ${pago === 'usd' ? 'Efectivo ($)' : 'Efectivo (Bs)'}`,
      '',
      `*Nombre:* ${datos.get('nombre')}`,
      `*Teléfono:* ${datos.get('telefono')}`,
      `*Cédula:* ${datos.get('cedula')}`,
    ];

    if (modalidad === 'delivery') {
      lineas.push(`*Dirección:* ${datos.get('direccion')}`);
      const referencia = String(datos.get('referencia') ?? '').trim();
      if (referencia) lineas.push(`*Referencia:* ${referencia}`);
    }

    const url = `https://wa.me/${whatsapp}?text=${encodeURIComponent(lineas.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });

  /* ── Inicialización ──────────────────────────────────────── */
  campoDireccion.required = true; // delivery por defecto
  filtrarSedes();
  pintarToggles();
  renderizar();
</script>
