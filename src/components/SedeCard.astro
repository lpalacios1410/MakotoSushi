---
/**
 * Card resumen de una sede. Se usa en la landing y en /sedes.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  sede: CollectionEntry<'sedes'>;
}

const { sede } = Astro.props;
const { nombre, ciudad, modalidades, horarios, direccion } = sede.data;

const horarioResumen = horarios.map((h) => `${h.dias}: ${h.apertura} a ${h.cierre}`).join(' · ');

const modEstilos: Record<string, string> = {
  restaurante: 'border-tertiary/40 text-tertiary',
  delivery: 'border-secondary/40 text-secondary',
  pickup: 'border-outline-variant/40 text-on-surface-variant',
};

const modIconos: Record<string, string> = {
  restaurante: 'table_restaurant',
  delivery: 'moped',
  pickup: 'takeout_dining',
};

const modEtiquetas: Record<string, string> = {
  restaurante: 'Restaurante',
  delivery: 'Delivery',
  pickup: 'Pick Up',
};

const mapaUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${direccion}, ${ciudad}, Venezuela`)}`;
---

<article class="group flex flex-col rounded-2xl border border-outline-variant/30 bg-surface-container-low p-6 transition-all duration-300 hover:border-primary-container/80">
  <div class="mb-3 flex items-start justify-between gap-3">
    <h3 class="font-headline-md text-headline-md text-on-surface transition-colors group-hover:text-primary">{nombre}</h3>
    <span class="font-label-sm text-label-sm uppercase text-on-surface/50">{ciudad}</span>
  </div>

  <!-- Modalidades -->
  <div class="mb-4 flex flex-wrap gap-2">
    {
      modalidades.map((mod) => (
        <span
          class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-label-sm text-label-sm font-bold tracking-wider uppercase ${modEstilos[mod]}`}
        >
          <span class="material-symbols-outlined text-sm" aria-hidden="true">
            {modIconos[mod]}
          </span>
          {modEtiquetas[mod]}
        </span>
      ))
    }
  </div>

  <!-- Horario -->
  <div class="mb-2 flex items-center gap-2 text-on-surface/70">
    <span class="material-symbols-outlined text-lg text-primary" aria-hidden="true">schedule</span>
    <p class="font-body-sm text-body-sm">{horarioResumen}</p>
  </div>

  <!-- Dirección -->
  <div class="mb-5 flex items-start gap-2 text-on-surface/70">
    <span class="material-symbols-outlined text-lg text-primary" aria-hidden="true">pin_drop</span>
    <p class="font-body-sm text-body-sm">{direccion}</p>
  </div>

  <!-- Acciones -->
  <div class="mt-auto flex flex-wrap items-center gap-3 border-t border-outline-variant/20 pt-4">
    <a
      class="inline-flex items-center gap-1.5 rounded-lg bg-primary-container px-4 py-2 font-label-sm text-label-sm font-bold text-on-primary-container transition-all hover:opacity-90 active:scale-95"
      href={`/sedes/${sede.id}/`}
    >
      Ver sede
    </a>
    <a
      class="inline-flex items-center gap-1.5 rounded-lg border border-outline-variant/40 bg-surface-container px-4 py-2 font-label-sm text-label-sm font-semibold text-on-surface transition-all hover:border-primary hover:text-primary"
      href={mapaUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      <span class="material-symbols-outlined text-base" aria-hidden="true">map</span>
      Cómo llegar
    </a>
  </div>
</article>
