---
/**
 * Card resumen de una sede. Se usa en la landing y en /sedes.
 */
import type { EntradaSede } from '../lib/tipos';

interface Props {
  sede: EntradaSede;
  /**
   * Nivel del encabezado de la card. En /sedes el título de la página es un
   * h1 y las sedes deben ser h2; en la landing (donde ya hay un h2 de sección)
   * se usa h3 para no saltarse niveles.
   */
  nivel?: 'h2' | 'h3';
}

const { sede, nivel = 'h3' } = Astro.props;
const { nombre, ciudad, modalidades, horarios, direccion } = sede.data;

const Titulo = nivel;

const horarioResumen = horarios.map((h) => `${h.dias}: ${h.apertura} a ${h.cierre}`).join(' · ');

const modEstilos: Record<string, string> = {
  restaurante: 'border-accent-line text-accent-strong bg-accent-soft',
  delivery: 'border-hairline text-ink-2 bg-card',
  pickup: 'border-hairline text-ink-2 bg-card',
};

const modIconos: Record<string, string> = {
  restaurante: 'table_restaurant',
  delivery: 'moped',
  pickup: 'takeout_dining',
};

const modEtiquetas: Record<string, string> = {
  restaurante: 'Restaurante',
  delivery: 'Delivery',
  pickup: 'Pick Up',
};

const mapaUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${direccion}, ${ciudad}, Venezuela`)}`;
---

<article class="j-card p-6" data-reveal>
  <div class="mb-3 flex items-start justify-between gap-3">
    <Titulo class="font-headline-md text-headline-md text-on-surface">{nombre}</Titulo>
    <span class="font-label-sm text-label-sm uppercase text-ink-3">{ciudad}</span>
  </div>

  <!-- Modalidades -->
  <div class="mb-4 flex flex-wrap gap-2">
    {
      modalidades.map((mod) => (
        <span
          class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-label-sm text-label-sm font-bold tracking-wider uppercase ${modEstilos[mod]}`}
        >
          <span class="material-symbols-outlined text-sm" aria-hidden="true">
            {modIconos[mod]}
          </span>
          {modEtiquetas[mod]}
        </span>
      ))
    }
  </div>

  <!-- Horario -->
  <div class="mb-2 flex items-start gap-2 text-ink-2">
    <span class="material-symbols-outlined text-lg text-accent-strong" aria-hidden="true">schedule</span>
    <p class="text-body-sm">{horarioResumen}</p>
  </div>

  <!-- Dirección -->
  <div class="mb-5 flex items-start gap-2 text-ink-2">
    <span class="material-symbols-outlined text-lg text-accent-strong" aria-hidden="true">pin_drop</span>
    <p class="text-body-sm">{direccion}</p>
  </div>

  <!-- Acciones -->
  <div class="mt-auto flex flex-wrap items-center gap-3 border-t border-hairline pt-4">
    <a
      class="j-btn j-btn-accent j-btn-sm"
      href={`/sedes/${sede.id}/`}
    >
      Ver sede<span class="sr-only"> {nombre}</span>
    </a>
    <a
      class="j-btn j-btn-line j-btn-sm"
      href={mapaUrl}
      rel="noopener noreferrer"
      target="_blank"
      aria-label={`Cómo llegar a la sede ${nombre} en Google Maps`}
    >
      <span class="material-symbols-outlined text-base" aria-hidden="true">map</span>
      Cómo llegar
    </a>
  </div>
</article>
