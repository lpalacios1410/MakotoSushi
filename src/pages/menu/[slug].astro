---
/**
 * Página de categoría del menú: lista de platos con botones "Añadir" al carrito.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DishCard from '../../components/DishCard.astro';
import MigasPan from '../../components/MigasPan.astro';
import { MARCA, URL_SITIO } from '../../config';

export async function getStaticPaths() {
  const categorias = await getCollection('menu');
  return categorias.map((categoria) => ({
    params: { slug: categoria.id },
    props: { categoria },
  }));
}

interface Props {
  categoria: CollectionEntry<'menu'>;
}

const { categoria } = Astro.props;
const { titulo, grupo, descripcion, items } = categoria.data;

// Navegación entre categorías (orden global)
const todas = (await getCollection('menu')).sort((a, b) => a.data.orden - b.data.orden);

const base = Astro.site?.href ?? URL_SITIO;

/** Migas de pan (visibles + datos estructurados). */
const migas = [
  { href: '/', texto: 'Inicio' },
  { href: '/menu/', texto: 'Menú' },
  { texto: titulo },
];

/** Datos estructurados: breadcrumb + lista de platos de la categoría. */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: migas.map((miga, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: miga.texto,
      ...(miga.href ? { item: new URL(miga.href, base).href } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${titulo} — ${MARCA.nombreCompleto}`,
    itemListElement: items.map((item, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      item: {
        '@type': 'MenuItem',
        name: item.nombre,
        description: item.descripcion,
        offers: {
          '@type': 'Offer',
          price: item.precio,
          priceCurrency: 'USD',
        },
      },
    })),
  },
];
---

<Layout
  title={`${titulo} — Menú ${MARCA.nombre}`}
  description={`${titulo}: ${descripcion ?? `Carta de ${titulo} de ${MARCA.nombreCompleto}.`} Precios en USD, delivery y pick-up en Caracas.`}
  activo="catalogo"
  ogType="website"
  schema={schema}
>
  <!-- Encabezado de la categoría -->
  <section class="border-b border-outline-variant/20 bg-surface-container-lowest py-10 md:py-14">
    <div class="mx-auto max-w-7xl px-6">
      <MigasPan items={migas} />
      <span class="mb-2 block font-label-sm text-label-sm uppercase tracking-widest text-primary">{grupo}</span>
      <h1 class="font-headline-lg text-headline-lg-mobile text-on-surface md:text-headline-lg">{titulo}</h1>
      {descripcion && <p class="mt-2 max-w-2xl font-body-md text-body-md text-on-surface/80">{descripcion}</p>}
    </div>
  </section>

  <!-- Navegación por categorías -->
  <div class="border-b border-outline-variant/20 bg-surface">
    <div class="scrollbar-none mx-auto flex max-w-7xl items-center gap-2 overflow-x-auto px-6 py-4" aria-label="Categorías del menú">
      {
        todas.map((cat) => (
          <a
            href={`/menu/${cat.id}/`}
            aria-current={cat.id === categoria.id ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap rounded-full px-4 py-2 font-label-sm text-label-sm transition-all',
              cat.id === categoria.id
                ? 'glow-primary bg-primary-container font-bold text-on-primary-container'
                : 'border border-outline-variant/30 bg-surface-container-high font-semibold text-on-surface/80 hover:bg-surface-container-highest hover:text-on-surface',
            ]}
          >
            {cat.data.titulo}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Platos -->
  <section class="bg-surface py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="sr-only">Platos de {titulo}</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {items.map((platillo) => <DishCard platillo={platillo} />)}
      </div>
      <p class="mt-10 text-center font-body-sm text-body-sm text-on-surface/70">
        Nuestros precios no incluyen IVA ni el 10% de servicio.
      </p>
    </div>
  </section>
</Layout>
