---
/**
 * Página de categoría del menú: lista de platos con botones "Añadir" al carrito.
 */
import Layout from '../../layouts/Layout.astro';
import DishCard from '../../components/DishCard.astro';
import MigasPan from '../../components/MigasPan.astro';
import { MARCA, URL_SITIO } from '../../config';
import { obtenerMenu } from '../../lib/contenido';
import type { EntradaMenu } from '../../lib/tipos';

export async function getStaticPaths() {
  const categorias = await obtenerMenu();
  return categorias.map((categoria) => ({
    params: { slug: categoria.id },
    props: { categoria },
  }));
}

interface Props {
  categoria: EntradaMenu;
}

const { categoria } = Astro.props;
const { titulo, grupo, descripcion, items } = categoria.data;

// Navegación entre categorías (orden global)
const todas = await obtenerMenu();

const base = Astro.site?.href ?? URL_SITIO;

/** Migas de pan (visibles + datos estructurados). */
const migas = [
  { href: '/', texto: 'Inicio' },
  { href: '/menu/', texto: 'Menú' },
  { texto: titulo },
];

/** Datos estructurados: breadcrumb + lista de platos de la categoría. */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: migas.map((miga, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: miga.texto,
      ...(miga.href ? { item: new URL(miga.href, base).href } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${titulo} — ${MARCA.nombreCompleto}`,
    itemListElement: items.map((item, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      item: {
        '@type': 'MenuItem',
        name: item.nombre,
        description: item.descripcion,
        offers: {
          '@type': 'Offer',
          price: item.precio,
          priceCurrency: 'USD',
        },
      },
    })),
  },
];
---

<Layout
  title={`${titulo} — Menú ${MARCA.nombre}`}
  description={`${titulo}: ${descripcion ?? `Carta de ${titulo} de ${MARCA.nombreCompleto}.`} Precios en USD, delivery y pick-up en Caracas.`}
  activo="catalogo"
  ogType="website"
  schema={schema}
>
  <!-- Encabezado de la categoría -->
  <section class="j-band border-b border-hairline">
    <div class="j-container">
      <div class="j-page-head j-page-head--plain">
        <MigasPan items={migas} />
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-accent-strong">{grupo}</span>
        <h1>{titulo}</h1>
        {descripcion && <p>{descripcion}</p>}
      </div>
    </div>
  </section>

  <!-- Navegación por categorías -->
  <div class="border-b border-hairline bg-surface">
    <div class="scrollbar-none mx-auto flex max-w-7xl items-center gap-2 overflow-x-auto px-6 py-4" aria-label="Categorías del menú">
      {
        todas.map((cat) => (
          <a
            href={`/menu/${cat.id}/`}
            aria-current={cat.id === categoria.id ? 'page' : undefined}
            class:list={[
              'j-tag whitespace-nowrap px-4 py-2 text-label-sm font-semibold transition-colors duration-300',
              cat.id === categoria.id
                ? 'border-accent-line bg-accent-soft font-bold text-accent-strong'
                : 'text-ink-2 hover:border-accent-line hover:text-on-surface',
            ]}
          >
            {cat.data.titulo}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Platos -->
  <section class="relative">
    <div class="j-container j-section">
      <h2 class="sr-only">Platos de {titulo}</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {items.map((platillo) => <DishCard platillo={platillo} />)}
      </div>
      <p class="mt-10 text-center text-body-sm text-ink-3">
        Nuestros precios no incluyen IVA ni el 10% de servicio.
      </p>
    </div>
  </section>
</Layout>
