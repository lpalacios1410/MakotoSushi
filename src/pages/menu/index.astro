---
/**
 * Índice del menú: todas las categorías agrupadas por grupo.
 */
import Layout from '../../layouts/Layout.astro';
import MigasPan from '../../components/MigasPan.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import { MARCA, URL_SITIO } from '../../config';
import { obtenerMenu } from '../../lib/contenido';

const categorias = await obtenerMenu();

// Agrupar por grupo superior respetando el orden de aparición
const grupos = new Map<string, typeof categorias>();
for (const cat of categorias) {
  const lista = grupos.get(cat.data.grupo) ?? [];
  lista.push(cat);
  grupos.set(cat.data.grupo, lista);
}

const iconos: Record<string, string> = {
  'Menú Ejecutivo': 'work',
  Entradas: 'restaurant_menu',
  Sushi: 'set_meal',
  'Platos Calientes': 'soup_kitchen',
  Combos: 'fastfood',
};

const base = Astro.site?.href ?? URL_SITIO;

/** Listado de categorías de la carta. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Carta de ${MARCA.nombreCompleto}`,
  itemListElement: categorias.map((cat, indice) => ({
    '@type': 'ListItem',
    position: indice + 1,
    item: {
      '@type': 'MenuSection',
      name: cat.data.titulo,
      url: new URL(`/menu/${cat.id}/`, base).href,
      ...(cat.data.descripcion ? { description: cat.data.descripcion } : {}),
    },
  })),
};
---

<Layout
  title={`Menú — ${MARCA.nombre}`}
  description={`Carta completa de ${MARCA.nombreCompleto}: menú ejecutivo, entradas, poke, rolls fríos y tempurizados, barcos, platos calientes y más.`}
  activo="catalogo"
  schema={schema}
>
  <section class="j-band border-b border-hairline">
    <div class="j-container">
      <div class="j-page-head j-page-head--plain">
        <MigasPan items={[{ href: '/', texto: 'Inicio' }, { texto: 'Menú' }]} />
        <SectionEyebrow numeral="01" etiqueta="Carta gastronómica" />
        <h1>Nuestro Menú Completo</h1>
        <p>
          Arma tu pedido por categoría y envíalo directo al WhatsApp de tu sede.
          Los precios no incluyen IVA ni el 10% de servicio.
        </p>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="j-container j-section">
      {
        [...grupos.entries()].map(([grupo, cats]) => (
          <div class="mb-14 last:mb-0">
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-full border border-hairline bg-card text-accent-strong">
                <span class="material-symbols-outlined text-xl" aria-hidden="true">
                  {iconos[grupo] ?? 'restaurant'}
                </span>
              </div>
              <h2 class="font-headline-md text-headline-md text-on-surface">{grupo}</h2>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {cats.map((cat) => (
                <a
                  class="j-card group flex-row items-center justify-between gap-4 p-5"
                  href={`/menu/${cat.id}/`}
                >
                  <div>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">{cat.data.titulo}</h3>
                    <p class="mt-1 text-body-sm text-ink-2">{cat.data.items.length} platos</p>
                  </div>
                  <span
                    class="material-symbols-outlined text-ink-3 transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent-strong"
                    aria-hidden="true"
                  >
                    arrow_forward
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
