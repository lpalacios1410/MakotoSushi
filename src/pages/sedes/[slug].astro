---
import Layout from '../../layouts/Layout.astro';
import MigasPan from '../../components/MigasPan.astro';
import { MARCA, URL_SITIO } from '../../config';
import { aHora24, diasSchema } from '../../lib/horarios';
import { obtenerSedes } from '../../lib/contenido';
import type { EntradaSede } from '../../lib/tipos';

export async function getStaticPaths() {
  const sedes = await obtenerSedes();
  return sedes.map((sede) => ({
    params: { slug: sede.id },
    props: { sede },
  }));
}

interface Props {
  sede: EntradaSede;
}

const { sede } = Astro.props;
const d = sede.data;

const base = Astro.site?.href ?? URL_SITIO;

const mapaQuery = encodeURIComponent(`${d.direccion}, ${d.ciudad}, Venezuela`);
const mapaEmbed = `https://maps.google.com/maps?q=${mapaQuery}&output=embed`;
const mapaUrl = `https://www.google.com/maps/search/?api=1&query=${mapaQuery}`;

const modEstilos: Record<string, string> = {
  restaurante: 'border-accent-line bg-accent-soft text-accent-strong',
  delivery: 'border-hairline bg-card text-ink-2',
  pickup: 'border-hairline bg-card text-ink-2',
};

const modIconos: Record<string, string> = {
  restaurante: 'table_restaurant',
  delivery: 'moped',
  pickup: 'takeout_dining',
};

const modEtiquetas: Record<string, string> = {
  restaurante: 'Restaurante',
  delivery: 'Delivery',
  pickup: 'Pick Up',
};

/** El enlace arma el pedido completo del carrito para esta sede. */
const whatsappUrl = d.whatsapp
  ? `https://wa.me/${d.whatsapp}?text=${encodeURIComponent(`Hola Makoto Sushi, quisiera hacer un pedido desde la sede ${d.nombre}.`)}`
  : null;

/** Datos estructurados de la sede (LocalBusiness) + migas de pan. */
const migas = [
  { href: '/', texto: 'Inicio' },
  { href: '/sedes/', texto: 'Sedes' },
  { texto: d.nombre },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Restaurant',
    '@id': `${base}sedes/${sede.id}/#sede`,
    name: `${d.nombre} — ${MARCA.nombreCompleto}`,
    parentOrganization: { '@id': `${base}#restaurante` },
    description: `Sede ${d.nombre} de ${MARCA.nombreCompleto} en ${d.ciudad}. ${d.modalidades.join(', ')}.`,
    url: new URL(`/sedes/${sede.id}/`, base).href,
    ...(d.whatsapp ? { telephone: `+${d.whatsapp}` } : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: d.direccion,
      addressLocality: d.ciudad,
      addressCountry: MARCA.pais,
    },
    hasMap: mapaUrl,
    servesCuisine: ['Sushi', 'Comida japonesa'],
    openingHoursSpecification: d.horarios
      .map((horario) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: diasSchema(horario.dias),
        opens: aHora24(horario.apertura),
        closes: aHora24(horario.cierre),
      }))
      .filter((spec) => spec.dayOfWeek.length > 0),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: migas.map((miga, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: miga.texto,
      ...(miga.href ? { item: new URL(miga.href, base).href } : {}),
    })),
  },
];
---

<Layout
  title={`${d.nombre} — Sede de ${MARCA.nombre}`}
  description={`Sede ${d.nombre}: horarios, dirección, modalidades y cómo llegar. ${MARCA.nombreCompleto}, ${d.ciudad}.`}
  activo="sedes"
  schema={schema}
>
  <!-- Encabezado de la sede -->
  <section class="j-band border-b border-hairline">
    <div class="j-container">
      <div class="j-page-head j-page-head--plain">
        <MigasPan items={migas} />

        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-accent-strong">Punto de Encuentro</span>
            <h1>{d.nombre}</h1>
            <p>{d.ciudad}, Venezuela</p>
          </div>

          <!-- Modalidades -->
          <div class="flex flex-wrap gap-2">
            {
              d.modalidades.map((mod) => (
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 font-label-sm text-label-sm font-bold tracking-wider uppercase ${modEstilos[mod]}`}
                >
                  <span class="material-symbols-outlined text-sm" aria-hidden="true">
                    {modIconos[mod]}
                  </span>
                  {modEtiquetas[mod]}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detalle: información + mapa -->
  <section class="relative">
    <div class="j-container j-section grid grid-cols-1 gap-10 lg:grid-cols-2">
      <!-- Columna de información -->
      <div class="flex flex-col gap-6">
        <!-- Horarios -->
        <div class="j-card p-6">
          <div class="mb-3 flex items-center gap-2 text-accent-strong">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">schedule</span>
            <span class="font-label-sm text-label-sm font-bold uppercase">Horario de Atención</span>
          </div>
          <ul class="flex flex-col gap-2">
            {
              d.horarios.map((h) => (
                <li class="flex items-center justify-between gap-4 border-b border-hairline pb-2 last:border-none last:pb-0">
                  <span class="text-body-md text-on-surface">{h.dias}</span>
                  <span class="text-body-md font-semibold text-on-surface">
                    {h.apertura} – {h.cierre}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Dirección -->
        <div class="j-card p-6">
          <div class="mb-3 flex items-center gap-2 text-accent-strong">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">pin_drop</span>
            <span class="font-label-sm text-label-sm font-bold uppercase">Dirección</span>
          </div>
          {
            d.centroComercial && <p class="mb-1 text-body-md text-on-surface">{d.centroComercial}</p>
          }
          {
            d.local && <p class="mb-1 text-body-md text-ink-2">{d.local}</p>
          }
          <p class="text-body-md text-on-surface">{d.direccion}</p>
          {
            d.comoLlegar && (
              <div class="mt-4 rounded-[14px] border border-hairline bg-paper-deep p-4">
                <p class="mb-1 flex items-center gap-1.5 font-label-sm text-label-sm font-bold uppercase text-accent-strong">
                  <span class="material-symbols-outlined text-sm" aria-hidden="true">
                    near_me
                  </span>
                  Cómo llegar
                </p>
                <p class="text-body-sm text-ink-2">{d.comoLlegar}</p>
              </div>
            )
          }
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            class="j-btn j-btn-line"
            href={mapaUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined" aria-hidden="true">map</span>
            Cómo Llegar en Google Maps
          </a>
          {
            whatsappUrl ? (
              <a
                class="j-btn j-btn-accent"
                href={whatsappUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                Pedir por WhatsApp
              </a>
            ) : (
              <span class="j-btn j-btn-line cursor-not-allowed opacity-50" title="Número de WhatsApp por confirmar">
                <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                Pedir por WhatsApp (próximamente)
              </span>
            )
          }
        </div>
      </div>

      <!-- Mapa -->
      <div class="overflow-hidden rounded-[22px] border border-hairline shadow-[var(--shadow-soft)]">
        <iframe
          src={mapaEmbed}
          class="h-full min-h-[380px] w-full"
          title={`Mapa de la sede ${d.nombre}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
