---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MigasPan from '../../components/MigasPan.astro';
import { MARCA, URL_SITIO } from '../../config';
import { aHora24, diasSchema } from '../../lib/horarios';

export async function getStaticPaths() {
  const sedes = await getCollection('sedes');
  return sedes.map((sede) => ({
    params: { slug: sede.id },
    props: { sede },
  }));
}

interface Props {
  sede: CollectionEntry<'sedes'>;
}

const { sede } = Astro.props;
const d = sede.data;

const base = Astro.site?.href ?? URL_SITIO;

const mapaQuery = encodeURIComponent(`${d.direccion}, ${d.ciudad}, Venezuela`);
const mapaEmbed = `https://maps.google.com/maps?q=${mapaQuery}&output=embed`;
const mapaUrl = `https://www.google.com/maps/search/?api=1&query=${mapaQuery}`;

const modEstilos: Record<string, string> = {
  restaurante: 'border-tertiary/40 text-tertiary',
  delivery: 'border-secondary/40 text-secondary',
  pickup: 'border-outline-variant/40 text-on-surface-variant',
};

const modIconos: Record<string, string> = {
  restaurante: 'table_restaurant',
  delivery: 'moped',
  pickup: 'takeout_dining',
};

const modEtiquetas: Record<string, string> = {
  restaurante: 'Restaurante',
  delivery: 'Delivery',
  pickup: 'Pick Up',
};

/** El enlace arma el pedido completo del carrito para esta sede. */
const whatsappUrl = d.whatsapp
  ? `https://wa.me/${d.whatsapp}?text=${encodeURIComponent(`Hola Makoto Sushi, quisiera hacer un pedido desde la sede ${d.nombre}.`)}`
  : null;

/** Datos estructurados de la sede (LocalBusiness) + migas de pan. */
const migas = [
  { href: '/', texto: 'Inicio' },
  { href: '/sedes/', texto: 'Sedes' },
  { texto: d.nombre },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Restaurant',
    '@id': `${base}sedes/${sede.id}/#sede`,
    name: `${d.nombre} — ${MARCA.nombreCompleto}`,
    parentOrganization: { '@id': `${base}#restaurante` },
    description: `Sede ${d.nombre} de ${MARCA.nombreCompleto} en ${d.ciudad}. ${d.modalidades.join(', ')}.`,
    url: new URL(`/sedes/${sede.id}/`, base).href,
    ...(d.whatsapp ? { telephone: `+${d.whatsapp}` } : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: d.direccion,
      addressLocality: d.ciudad,
      addressCountry: MARCA.pais,
    },
    hasMap: mapaUrl,
    servesCuisine: ['Sushi', 'Comida japonesa'],
    openingHoursSpecification: d.horarios
      .map((horario) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: diasSchema(horario.dias),
        opens: aHora24(horario.apertura),
        closes: aHora24(horario.cierre),
      }))
      .filter((spec) => spec.dayOfWeek.length > 0),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: migas.map((miga, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: miga.texto,
      ...(miga.href ? { item: new URL(miga.href, base).href } : {}),
    })),
  },
];
---

<Layout
  title={`${d.nombre} — Sede de ${MARCA.nombre}`}
  description={`Sede ${d.nombre}: horarios, dirección, modalidades y cómo llegar. ${MARCA.nombreCompleto}, ${d.ciudad}.`}
  activo="sedes"
  schema={schema}
>
  <!-- Encabezado de la sede -->
  <section class="border-b border-outline-variant/20 bg-surface-container-lowest py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-6">
      <MigasPan items={migas} />

      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="mb-2 block font-label-sm text-label-sm uppercase tracking-widest text-primary">Punto de Encuentro</span>
          <h1 class="font-headline-lg text-headline-lg-mobile text-on-surface md:text-headline-lg">{d.nombre}</h1>
          <p class="mt-2 font-body-md text-body-md text-on-surface/80">{d.ciudad}, Venezuela</p>
        </div>

        <!-- Modalidades -->
        <div class="flex flex-wrap gap-2">
          {
            d.modalidades.map((mod) => (
              <span
                class={`inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 font-label-sm text-label-sm font-bold tracking-wider uppercase ${modEstilos[mod]}`}
              >
                <span class="material-symbols-outlined text-sm" aria-hidden="true">
                  {modIconos[mod]}
                </span>
                {modEtiquetas[mod]}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Detalle: información + mapa -->
  <section class="bg-surface py-12 md:py-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 lg:grid-cols-2">
      <!-- Columna de información -->
      <div class="flex flex-col gap-6">
        <!-- Horarios -->
        <div class="rounded-2xl border border-outline-variant/30 bg-surface-container p-6">
          <div class="mb-3 flex items-center gap-2 text-primary">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">schedule</span>
            <span class="font-label-sm text-label-sm font-bold uppercase">Horario de Atención</span>
          </div>
          <ul class="flex flex-col gap-2">
            {
              d.horarios.map((h) => (
                <li class="flex items-center justify-between gap-4 border-b border-outline-variant/20 pb-2 last:border-none last:pb-0">
                  <span class="font-body-md text-body-md text-on-surface">{h.dias}</span>
                  <span class="font-body-md text-body-md font-semibold text-on-surface/90">
                    {h.apertura} – {h.cierre}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Dirección -->
        <div class="rounded-2xl border border-outline-variant/30 bg-surface-container p-6">
          <div class="mb-3 flex items-center gap-2 text-primary">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">pin_drop</span>
            <span class="font-label-sm text-label-sm font-bold uppercase">Dirección</span>
          </div>
          {
            d.centroComercial && <p class="mb-1 font-body-md text-body-md text-on-surface">{d.centroComercial}</p>
          }
          {
            d.local && <p class="mb-1 font-body-md text-body-md text-on-surface/90">{d.local}</p>
          }
          <p class="font-body-md text-body-md text-on-surface">{d.direccion}</p>
          {
            d.comoLlegar && (
              <div class="mt-4 rounded-xl border border-outline-variant/20 bg-surface-container-low p-4">
                <p class="mb-1 flex items-center gap-1.5 font-label-sm text-label-sm font-bold uppercase text-tertiary">
                  <span class="material-symbols-outlined text-sm" aria-hidden="true">
                    near_me
                  </span>
                  Cómo llegar
                </p>
                <p class="font-body-sm text-body-sm text-on-surface/80">{d.comoLlegar}</p>
              </div>
            )
          }
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            class="inline-flex items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-high px-6 py-3 font-label-md text-label-md font-semibold text-on-surface transition-all hover:border-primary hover:text-primary"
            href={mapaUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined text-primary" aria-hidden="true">map</span>
            Cómo Llegar en Google Maps
          </a>
          {
            whatsappUrl ? (
              <a
                class="inline-flex items-center gap-2 rounded-lg bg-secondary px-6 py-3 font-label-md text-label-md font-bold tracking-wider text-on-secondary transition-all hover:opacity-90 active:scale-95"
                href={whatsappUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                Pedir por WhatsApp
              </a>
            ) : (
              <span class="inline-flex cursor-not-allowed items-center gap-2 rounded-lg border border-outline-variant/30 bg-surface-container px-6 py-3 font-label-md text-label-md font-semibold text-on-surface/60" title="Número de WhatsApp por confirmar">
                <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                Pedir por WhatsApp (próximamente)
              </span>
            )
          }
        </div>
      </div>

      <!-- Mapa -->
      <div class="overflow-hidden rounded-2xl border border-outline-variant/40 shadow-2xl">
        <iframe
          src={mapaEmbed}
          class="h-full min-h-[380px] w-full"
          title={`Mapa de la sede ${d.nombre}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
