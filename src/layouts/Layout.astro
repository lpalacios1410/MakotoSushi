---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Carrito from '../components/Carrito.astro';
import { MARCA, URL_SITIO, IMAGEN_PLATO, LOGO_URL } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Id de la sección activa para el subrayado del Navbar */
  activo?: string;
  /** Tipo de contenido para Open Graph (por defecto "website"). */
  ogType?: 'website' | 'article' | 'restaurant.menu_item';
  /** Imagen social (por defecto, el plato destacado). */
  ogImage?: string;
  /** Bloques JSON-LD adicionales (structured data) de la página. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Evita que la página se indexe (p. ej. páginas de error). */
  noindex?: boolean;
}

const {
  title,
  description = `${MARCA.nombreCompleto} — ${MARCA.lema}. Sushi de autor, delivery y pick-up en Caracas, Venezuela.`,
  activo,
  ogType = 'website',
  ogImage = IMAGEN_PLATO,
  schema,
  noindex = false,
} = Astro.props;

const base = Astro.site?.href ?? URL_SITIO;
/** URL canónica de la página (self-referencing). */
const canonical = new URL(Astro.url.pathname, base).href;
/** Imagen social absoluta (Open Graph exige URL absoluta). */
const imagenSocial = new URL(ogImage).href;

/** Datos estructurados de la marca (JSON-LD). */
const schemaMarca = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${base}#restaurante`,
  name: MARCA.nombreCompleto,
  alternateName: MARCA.nombre,
  description: MARCA.descripcion,
  url: base,
  image: imagenSocial,
  logo: LOGO_URL,
  telephone: `+${MARCA.whatsapp}`,
  priceRange: '$$',
  servesCuisine: ['Sushi', 'Comida japonesa', 'Comida asiática'],
  currenciesAccepted: 'USD',
  hasMenu: `${base}menu/`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: MARCA.ciudad,
    addressRegion: MARCA.region,
    addressCountry: MARCA.pais,
  },
  areaServed: MARCA.ciudad,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '10:00',
      closes: '23:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
      opens: '10:00',
      closes: '00:00',
    },
  ],
};

const bloquesSchema = Array.isArray(schema) ? [schemaMarca, ...schema] : [schemaMarca, ...(schema ? [schema] : [])];
---

<!doctype html>
<html lang="es-VE" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#131315" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <!-- Canonical y Open Graph -->
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={MARCA.nombreCompleto} />
    <meta property="og:locale" content={MARCA.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:alt" content={`${MARCA.nombreCompleto} — ${MARCA.lema}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenSocial} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts: Montserrat (titulares) + DM Sans (cuerpo) + Material Symbols (iconografía) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {/* Structured data (JSON-LD) */}
    {
      bloquesSchema.map((bloque) => (
        <script type="application/ld+json" set:html={JSON.stringify(bloque)} />
      ))
    }
  </head>
  <body class="bg-background text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container">
    <a class="skip-link" href="#contenido-principal">Ir al contenido principal</a>
    <Navbar activo={activo} />
    <main id="contenido-principal">
      <slot />
    </main>
    <Footer />
    <Carrito />
  </body>
</html>
