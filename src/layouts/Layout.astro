---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Carrito from '../components/Carrito.astro';

interface Props {
  title: string;
  description?: string;
  /** Id de la sección activa para el subrayado del Navbar */
  activo?: string;
}

const {
  title,
  description = 'Makoto Sushi / Letsgo Sushi — Adictos al Verdadero Sabor Japonés. Sushi de autor, delivery y pick-up en Caracas, Venezuela.',
  activo,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts: Montserrat (titulares) + DM Sans (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols Outlined (iconografía del design system) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-background text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container">
    <Navbar activo={activo} />
    <main>
      <slot />
    </main>
    <Footer />
    <Carrito />
  </body>
</html>
